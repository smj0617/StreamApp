# StreamApp 서버 환경변수. 서버의 /etc/streamapp/streamapp.env로 복사해 값을 채운다(권한 640, root:streamapp).
# setup-server.sh가 처음 한 번 이 파일을 복사하면서 __DOMAIN__과 __PUBLIC_IP__를 바꿔 넣는다. 이미 있으면 덮어쓰지 않는다.
#
# - streamapp.service(앱)와 mediamtx.service(MediaMTX)가 함께 읽는다. MTX_로 시작하는 값은 MediaMTX 설정
#   (/etc/streamapp/mediamtx.yml)을 덮어쓰고, 나머지는 앱이 읽는다.
# - systemd EnvironmentFile 형식이다: KEY=값 한 줄에 하나, 변수 펼치기($X)는 되지 않는다.
# - 비밀 값(토스 시크릿 키, 기본 비밀번호)은 이 서버 파일에만 적고 저장소에 커밋하지 않는다. 아래 값은 자리 표시다.
# - 바꾼 뒤: sudo systemctl restart mediamtx streamapp

########## 앱이 듣는 주소(dioxus::serve가 읽는다. 없으면 127.0.0.1:8080) ##########
# 바깥에는 Caddy(80·443)만 열고 앱은 서버 안에서만 듣는다. 포트를 바꾸면 deploy/Caddyfile과
# deploy/mediamtx.yml(authHTTPAddress, 훅 주소)도 같이 바꾼다.
IP=127.0.0.1
PORT=8080

########## 데이터(기본값은 작업 폴더 /var/lib/streamapp 기준 data/...) ##########
STREAMAPP_DB=/var/lib/streamapp/data/streamapp.db
STREAMAPP_RECORDINGS_DIR=/var/lib/streamapp/data/recordings

########## 공개 주소 ##########
# 시청자가 받는 라이브 HLS 주소의 앞부분. 재생 주소는 <이 값>/<채널ID>/index.m3u8이고,
# /api/watch/{channel_id}와 /api/live-channels 응답의 playback_url에 그대로 실린다(데스크톱 클라이언트도 이 값으로 재생).
# Caddy가 /hls/*를 앞부분을 떼고 MediaMTX(127.0.0.1:8888)로 넘긴다. 없으면 http://localhost:8888(로컬 개발용).
STREAMAPP_HLS_BASE_URL=https://__DOMAIN__/hls
# 내 채널 설정 화면의 OBS "서버" 칸 값. 없으면 rtmp://localhost/. 1935를 열지 않았으면 OBS 송출은 안 된다.
STREAMAPP_OBS_SERVER=rtmp://__DOMAIN__/
# 세션 쿠키에 Secure를 붙여 HTTPS 요청에만 싣는다. 배포 서버는 HTTPS로만 서비스하므로 켠다(로컬 개발은 끔).
STREAMAPP_SECURE_COOKIE=true

########## MediaMTX 연결(서버 안. 기본값 그대로 둔다) ##########
# Control API: 앱 시작 시 송출 상태 맞추기, /healthz의 mediamtx 항목
STREAMAPP_MEDIAMTX_API=http://127.0.0.1:9997
# WebRTC HTTP: 휴대폰 방송 WHIP 중계
STREAMAPP_MEDIAMTX_WEBRTC=http://127.0.0.1:8889

########## 로그인 ##########
# 빈 DB에 처음 만드는 기본 사용자(철수·영희·민수)의 비밀번호(8~64자). 공개 서버이므로 반드시 바꾼다.
# 기본값(test1234)을 그대로 두면 누구나 기본 사용자로 로그인할 수 있다.
STREAMAPP_DEFAULT_PASSWORD=__CHANGE_ME_DEFAULT_PASSWORD__

########## 후원 결제(토스페이먼츠 테스트 모드, 선택) ##########
# 두 키가 모두 있어야 후원이 켜진다. test_로 시작하는 테스트 키만 받는다. 비워 두면 후원 결제를 끈다.
# 결제 상태 변경 웹훅은 토스 개발자센터에 https://__DOMAIN__/api/payments/toss/webhook 으로 등록한다.
STREAMAPP_TOSS_CLIENT_KEY=
STREAMAPP_TOSS_SECRET_KEY=
# STREAMAPP_TOSS_API=https://api.tosspayments.com

########## MediaMTX 설정 덮어쓰기(MTX_<대문자 키>, 리스트는 쉼표로 구분) ##########
# HLS를 받아 갈 수 있는 출처. 재생 페이지와 같은 출처다.
MTX_HLSALLOWORIGINS=https://__DOMAIN__
# 휴대폰 송출(WebRTC ICE)에 알릴 이 서버의 공인 IP. OCI 콘솔의 인스턴스 "공용 IP 주소"와 같아야 한다.
MTX_WEBRTCADDITIONALHOSTS=__PUBLIC_IP__
